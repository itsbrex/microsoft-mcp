# Microsoft MCP configuration — copy to .env and fill in.
# Only MICROSOFT_MCP_CLIENT_ID is required. Everything else is optional.

# --- Required ---------------------------------------------------------------
# Azure AD application (client) ID.
# For MSAL device-code flow use the Microsoft Office public client id:
#   d3590ed6-52b3-4102-aeff-aad2292ab01c
MICROSOFT_MCP_CLIENT_ID=

# --- Auth -------------------------------------------------------------------
# "azure" (default, InteractiveBrowserCredential) or "msal" (device-code flow).
MICROSOFT_MCP_AUTH_METHOD=
# Defaults to "common" (multi-tenant).
# MICROSOFT_MCP_TENANT_ID=
# Account identifier for per-account token file naming (typically your email).
MICROSOFT_MCP_ACCOUNT_ID=
# MSAL token storage dir (default ~/.config/microsoft-mcp/tokens/).
# MICROSOFT_MCP_TOKENS_DIR=
# Skip the refresh-all-accounts pass at MSAL startup (default "1" = on).
# MICROSOFT_MCP_REFRESH_ON_STARTUP=

# Azure-SDK only: custom redirect URI for non-localhost deployments.
# MICROSOFT_MCP_REDIRECT_URI=
# Azure-SDK only: custom auth-record / token-cache paths.
# AZURE_CRED_CACHE_FILE=
# AZURE_TOKEN_CACHE_FILE=

# --- Response shaping -------------------------------------------------------
# "legacy" (default) or "assistant" — controls list/search response shaping.
# MICROSOFT_MCP_RESPONSE_PROFILE=

# --- Signatures (local plain-text store) ------------------------------------
# MICROSOFT_MCP_SIGNATURES_DIR=
# MICROSOFT_MCP_SIGNATURE_ACCOUNT=
# MICROSOFT_MCP_DEFAULT_SIGNATURE=
# MICROSOFT_MCP_REPLY_SIGNATURE=
# MICROSOFT_MCP_SIGNATURE_RFC3676=

# --- Email templates --------------------------------------------------------
# Template search dir (default ~/.config/microsoft-mcp/templates/).
# MICROSOFT_MCP_TEMPLATES_DIR=

# --- Code mode --------------------------------------------------------------
MICROSOFT_MCP_CODE_MODE_DIR=
