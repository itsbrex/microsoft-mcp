# Microsoft MCP Configuration
# Copy this file to .env and update with your values

# Required: Azure AD Application (client) ID
MICROSOFT_MCP_CLIENT_ID=your-app-id-here

# Optional: Azure AD Tenant ID (defaults to "common" for multi-tenant)
MICROSOFT_MCP_TENANT_ID=common

# Optional: Custom redirect URI for non-localhost deployments
# If not set, InteractiveBrowserCredential will use default localhost URLs
# Common examples:
# - For Azure Web Apps: https://your-app.azurewebsites.net/auth/callback
# - For custom domains: https://your-domain.com/auth/callback
# - For mobile apps: myapp://auth
# MICROSOFT_MCP_REDIRECT_URI=https://your-app.azurewebsites.net/auth/callback

# --- Email signatures (local plain-text store) ---
# Optional: override the directory where signature files live.
# Default: ~/.config/microsoft-mcp/signatures/
# MICROSOFT_MCP_SIGNATURES_DIR=

# Optional: override the account slug used in signature filenames
# (<account-slug>-<name>.txt). If unset, the slug is derived by lowercasing
# and dash-cleaning MICROSOFT_MCP_ACCOUNT_ID.
# MICROSOFT_MCP_SIGNATURE_ACCOUNT=brian-work

# Optional: signature name appended to new drafts when create_email_draft
# is called without an explicit `signature` argument. Pass signature="none"
# at the call site to suppress for one call.
# MICROSOFT_MCP_DEFAULT_SIGNATURE=default

# Optional: signature name appended to reply / reply_all drafts. Falls back
# to MICROSOFT_MCP_DEFAULT_SIGNATURE when unset.
# MICROSOFT_MCP_REPLY_SIGNATURE=replies

# Optional: set to "1" to use the RFC 3676 sig delimiter ("\n\n-- \n")
# between body and signature instead of the default "\n\n".
# MICROSOFT_MCP_SIGNATURE_RFC3676=0
